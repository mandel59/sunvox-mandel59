{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunvox-projects",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sunvox-projects.ryusei.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*.sunvox", "/*.sunsynth"]
  }
}
